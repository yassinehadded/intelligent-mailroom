APP_NAME=Intelligent Mailroom
APP_ENV=development
LOG_LEVEL=INFO

# API (Docker maps API_PORT host port)
API_PORT=8000

# Docker Compose — Maarch URL reachable from inside containers (Windows/Mac)
MAARCH_DOCKER_URL=http://host.docker.internal:8081

MAARCH_URL=http://localhost:8081
MAARCH_USERNAME=superadmin
MAARCH_PASSWORD=superadmin
MAARCH_TIMEOUT=30
MAARCH_DEFAULT_MODEL_ID=8
MAARCH_DEFAULT_STATUS=INIT
MAARCH_DEFAULT_ATTACHMENT_TYPE=incoming_mail_attachment

EMAIL_HOST=
EMAIL_PORT=993
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_USE_SSL=true
EMAIL_MAILBOX=INBOX
EMAIL_FETCH_LIMIT=20
EMAIL_MARK_AS_READ=true
EMAIL_DEFAULT_DESTINATION=13
EMAIL_POLL_INTERVAL_SECONDS=60

OCR_ENABLED=true
OCR_TESSERACT_ENABLED=false
OCR_TESSERACT_LANG=fra+eng

AI_ENABLED=true
AI_PROVIDER=rules
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
OPENAI_TIMEOUT=60
CLASSIFICATION_MIN_CONFIDENCE=0.5

MAARCH_RETRY_COUNT=3
MAARCH_RETRY_BACKOFF_SECONDS=1.0
MAARCH_AUTO_CREATE_CONTACTS=true

AUDIT_ENABLED=true
AUDIT_DB_PATH=data/audit.db
